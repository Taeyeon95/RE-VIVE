# Neon(https://neon.tech) 콘솔 > 프로젝트 > Connection string 에서 복사한 값을 붙여넣으세요.
# (?sslmode=require 가 포함된 형태 그대로 사용하면 됩니다.)
DATABASE_URL=

# 세션 쿠키(JWT) 서명에 쓰이는 임의의 긴 비밀 문자열입니다. 아래 명령으로 생성해서 채우세요.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# API 서버 포트 (기본값 8787, 보통 바꿀 필요 없음)
PORT=8787
